# Copy to .env and fill from Firebase console > Project settings > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check: reCAPTCHA Enterprise site key (Firebase console > Security > App Check > Apps)
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Debug token registered under App Check > Apps > (your app) > Manage debug tokens. Dev only.
VITE_APPCHECK_DEBUG_TOKEN=
